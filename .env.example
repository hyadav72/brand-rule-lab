# Brand Rule Lab - Environment Configuration
# Copy this file to .env and adjust variables as required.

# LLM Execution Mode: 'mock' (deterministic offline demo/testing), 'live', 'gemini', 'nvidia', or 'dual'
LLM_MODE=mock

# Unified Dual-Provider Architecture (ProviderManager)
LLM_PRIMARY_PROVIDER=gemini
LLM_SECONDARY_PROVIDER=nvidia
LLM_FALLBACK_PROVIDER=mock

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# NVIDIA NIM Configuration (OpenAI-compatible)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=mistralai/mistral-7b-instruct-v0.3
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Legacy single-provider aliases (backward compatibility)
LLM_PROVIDER=gemini
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-3.1-flash-lite

# Database Configuration
DATABASE_PATH=data/brand_rule_lab.db

# OCR Configuration (Optional fallback: if absent, image OCR gracefully reports unavailable)
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
